DATABASE_URL="postgresql://usuario:senha@localhost:5432/gerenciador_projetos?schema=public"

# Obrigatório, com pelo menos 32 caracteres (a API não sobe sem ele). Gere um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=3000

# Endereços do front-end autorizados (separados por vírgula)
CORS_ORIGIN="http://localhost:4200"

# Opcionais (valores padrão entre parênteses)
# JWT_EXPIRES_IN="1d"        # validade do token de login (1d)
# BCRYPT_ROUNDS=12           # custo do hash de senha, entre 4 e 15 (12)
# AUTH_RATE_LIMIT_MAX=10     # tentativas de login/cadastro por IP a cada janela (10)
# INVITE_RATE_LIMIT_MAX=30   # convites por pessoa a cada hora e consultas de link por IP (30)
# TRUST_PROXY=1              # use 1 quando a API roda atrás de um proxy (Render, Railway...)
